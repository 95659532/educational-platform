# Local Development - Copy to .env.local and fill values

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/edunova_dev"

# JWT Configuration
JWT_SECRET="dev-secret-key-min-32-characters-long-here"
JWT_EXPIRES_IN="7d"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Admin Configuration
ADMIN_EMAIL="admin@edunova.com"
ADMIN_PASSWORD="Admin123!"

# Email Configuration (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# API Configuration
API_RATE_LIMIT="1000"
API_TIMEOUT="30000"